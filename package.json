{
  "name": "uestc-spa-faculty-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node scripts/build-public-data.mjs",
    "validate": "node scripts/validate-public-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.js && npm run data && npm run validate && npm test",
    "build": "npm run check && node scripts/stage-site.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
